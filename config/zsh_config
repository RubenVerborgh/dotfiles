# Only run on Zsh
[ -z "$ZSH_NAME" ] && return

# Don't error on failed globs
setopt NO_NOMATCH

# Enable vi editing mode
setopt vi

# Enable Ctrl-R
bindkey -v
bindkey '^R' history-incremental-search-backward

# Make history ignore duplicates, ls, ll, and commands starting with spaces
setopt histignorespace
setopt histignoredups
setopt histfindnodups
setopt histreduceblanks
setopt histnostore

# Informative prompt with git repository info
setopt PROMPT_SUBST
autoload -U colors && colors
# Prompt for local machine
if [ -z "$SSH_CONNECTION" ]; then
  PROMPT='%{$fg[cyan]%}%m:%{$fg[green]%}%1~'
# Prompt for remote machines
else
  PROMPT='%{$fg[green]%}%n@%m:%1~'
fi
PROMPT+='%{$fg[red]%}$(__git_ps1)'
PROMPT+='%{$reset_color%}%% '

# Aliases
alias steve=jobs
