set linespace=1
set antialias
set encoding=utf-8
set guioptions-=T         " Hide toolbar.
set number                " Show line numbers.
set tabpagemax=30         " Allow more tabs to open

if has("mac")
  set guifont=Menlo:h13
elseif has("gui_gtk3") || has("gui_gtk2")
  set guifont=DejaVu\ Sans\ Mono\ 11
endif
